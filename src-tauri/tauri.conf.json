{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex 远程模型同步",
  "version": "0.1.0",
  "identifier": "com.local.sync-codex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex 远程模型同步",
        "decorations": false,
        "shadow": true,
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Codex 远程模型同步",
    "longDescription": "读取本地 CC Switch 模型目录并同步到远程主机"
  }
}
